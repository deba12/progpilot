parameters:
	ignoreErrors:
		-
			message: '#^Call to function is_null\(\) with array will always evaluate to false\.$#'
			identifier: function.impossibleType
			count: 1
			path: package/src/progpilot/Analysis/IncludeAnalysis.php

		-
			message: '#^Comparison operation "\>" between int\<1, max\> and 0 is always true\.$#'
			identifier: greater.alwaysTrue
			count: 1
			path: package/src/progpilot/Analysis/ResolveDefs.php

		-
			message: '#^Variable \$def2IncludedByDef1 might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: package/src/progpilot/Analysis/ResolveDefs.php

		-
			message: '#^Variable \$def2IncludedToDef1 might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: package/src/progpilot/Analysis/ResolveDefs.php

		-
			message: '#^Left side of && is always true\.$#'
			identifier: booleanAnd.leftAlwaysTrue
			count: 1
			path: package/src/progpilot/Analysis/SecurityAnalysis.php

		-
			message: '#^Variable \$exprsTaintedconditionsSanitize might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: package/src/progpilot/Analysis/TaintAnalysis.php

		-
			message: '#^Method progpilot\\Analysis\\VisitorAnalysis\:\:analyzeFunc\(\) invoked with 3 parameters, 1\-2 required\.$#'
			identifier: arguments.count
			count: 1
			path: package/src/progpilot/Analyzer.php

		-
			message: '#^Call to an undefined method progpilot\\ContextInternalApi\:\:setAnalyzeIncludes\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: package/src/progpilot/ContextInternalApi.php

		-
			message: '#^Call to an undefined method progpilot\\ContextInternalApi\:\:setDebugMode\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: package/src/progpilot/ContextInternalApi.php

		-
			message: '#^Call to an undefined method progpilot\\ContextInternalApi\:\:setMaxDefinitions\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: package/src/progpilot/ContextInternalApi.php

		-
			message: '#^Call to an undefined method progpilot\\ContextInternalApi\:\:setMaxFileAnalysisDuration\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: package/src/progpilot/ContextInternalApi.php

		-
			message: '#^Call to an undefined method progpilot\\ContextInternalApi\:\:setMaxFileSize\(\)\.$#'
			identifier: method.notFound
			count: 2
			path: package/src/progpilot/ContextInternalApi.php

		-
			message: '#^Call to an undefined method progpilot\\ContextInternalApi\:\:setPrettyPrint\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: package/src/progpilot/ContextInternalApi.php

		-
			message: '#^Method progpilot\\Objects\\MyDefState\:\:setIsEmbeddedByChars\(\) invoked with 2 parameters, 1 required\.$#'
			identifier: arguments.count
			count: 2
			path: package/src/progpilot/Helpers/State.php

		-
			message: '#^Result of && is always false\.$#'
			identifier: booleanAnd.alwaysFalse
			count: 3
			path: package/src/progpilot/Inputs/MyInputsInternalApi.php

		-
			message: '#^Strict comparison using \=\=\= between bool and 0 will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 3
			path: package/src/progpilot/Inputs/MyInputsInternalApi.php

		-
			message: '#^Variable \$folders in empty\(\) always exists and is not falsy\.$#'
			identifier: empty.variable
			count: 2
			path: package/src/progpilot/Inputs/MyInputsInternalApi.php

		-
			message: '#^Method progpilot\\Representations\\AbstractSyntaxTree\:\:afterTraverse\(\) should return array\<PhpParser\\Node\>\|null but return statement is missing\.$#'
			identifier: return.missing
			count: 1
			path: package/src/progpilot/Representations/AbstractSyntaxTree.php

		-
			message: '#^Method progpilot\\Representations\\AbstractSyntaxTree\:\:beforeTraverse\(\) should return array\<PhpParser\\Node\>\|null but return statement is missing\.$#'
			identifier: return.missing
			count: 1
			path: package/src/progpilot/Representations/AbstractSyntaxTree.php

		-
			message: '#^Method progpilot\\Representations\\AbstractSyntaxTree\:\:enterNode\(\) should return array\<PhpParser\\Node\>\|int\|PhpParser\\Node\|null but return statement is missing\.$#'
			identifier: return.missing
			count: 1
			path: package/src/progpilot/Representations/AbstractSyntaxTree.php

		-
			message: '#^Method progpilot\\Representations\\AbstractSyntaxTree\:\:leaveNode\(\) should return array\<PhpParser\\Node\>\|int\|PhpParser\\Node\|null but return statement is missing\.$#'
			identifier: return.missing
			count: 1
			path: package/src/progpilot/Representations/AbstractSyntaxTree.php

		-
			message: '#^Access to an undefined property PHPCfg\\Operand\:\:\$value\.$#'
			identifier: property.notFound
			count: 1
			path: package/src/progpilot/Transformations/Php/Exprs/StaticPropertyFetch.php

		-
			message: '#^Access to an undefined property PHPCfg\\Operand\:\:\$value\.$#'
			identifier: property.notFound
			count: 3
			path: package/src/progpilot/Transformations/Php/Transform.php

		-
			message: '#^Call to function is_null\(\) with PHPCfg\\Operand\\Literal will always evaluate to false\.$#'
			identifier: function.impossibleType
			count: 1
			path: package/src/progpilot/Transformations/Php/Transform.php
