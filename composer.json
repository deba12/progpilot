{
    "name": "designsecurity/progpilot",
    "description": "A Static Analyser for security",
    "license": "MIT",
    "authors": [
        {
            "name": "Eric Therond",
            "email": "eric.therond.fr@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ircmaxell/php-cfg": "^0.8.1",
        "symfony/yaml": "^8.1",
        "symfony/console": "^8.1",
        "myclabs/deep-copy": "^1.14",
        "bartlett/sarif-php-sdk": "^2.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "phpro/grumphp": "^2.26",
        "squizlabs/php_codesniffer": "^4.0",
        "phpstan/phpstan": "^2.3",
        "vimeo/psalm": "^6.20"
    },
    "bin": [
        "projects/phar/progpilot"
    ],
    "autoload": {
        "psr-4": {
            "progpilot\\": "package/src/progpilot/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpro/grumphp": true
        }
    },
    "scripts": {
        "lint": "phpcs --standard=PSR12 --ignore=*/projects/tests/* package/src",
        "lint:fix": "phpcbf --standard=PSR12 --ignore=*/projects/tests/* package/src",
        "phpstan": "phpstan analyse --no-progress",
        "psalm": "psalm --no-progress",
        "test": "cd projects/tests && php vendor/bin/phpunit",
        "gate": [
            "@lint",
            "@phpstan",
            "@psalm",
            "@test",
            "@composer audit"
        ]
    }
}
